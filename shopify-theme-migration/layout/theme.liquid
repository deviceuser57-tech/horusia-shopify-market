<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ settings.heading_font | font_face: font_display: 'swap' }}
    {{ settings.body_font | font_face: font_display: 'swap' }}
    <script>
      window.Shopify = window.Shopify || {};
      window.Shopify.money_format = {{ shop.money_format | json }};
      window.Shopify.currency = window.Shopify.currency || {};
      window.Shopify.currency.active = {{ cart.currency.iso_code | json }};
    </script>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
  </head>
  <body class="template-{{ template.name }}" style="--color-background: {{ settings.color_background }}; --color-foreground: {{ settings.color_foreground }}; --color-primary: {{ settings.color_primary }}; --color-border: {{ settings.color_border }}; font-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }}; --font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    <script type="application/json" data-i18n>{
      "add_to_cart": {{ 'general.product.add_to_cart' | t | json }},
      "sold_out": {{ 'general.product.sold_out' | t | json }},
      "added_to_cart": {{ 'general.product.added_to_cart' | t | json }},
      "add_error": {{ 'general.product.add_error' | t | json }},
      "invalid_quantity": {{ 'general.product.invalid_quantity' | t | json }},
      "combination_unavailable": {{ 'general.product.combination_unavailable' | t | json }},
      "cart_empty": {{ 'general.cart.empty' | t | json }},
      "cart_subtotal": {{ 'general.cart.subtotal' | t | json }},
      "cart_checkout": {{ 'general.cart.checkout' | t | json }},
      "cart_remove": {{ 'general.cart.remove' | t | json }},
      "cart_update_error": {{ 'general.cart.update_error' | t | json }},
      "cart_quantity": {{ 'general.product.quantity' | t | json }},
      "carousel_pause": {{ 'general.carousel.pause' | t | json }},
      "carousel_play": {{ 'general.carousel.play' | t | json }},
      "view_cart": {{ 'general.cart.view_cart' | t | json }},
      "cart_js_url": {{ routes.cart_url | append: '.js' | json }},
      "cart_add_url": {{ routes.cart_add_url | append: '.js' | json }},
      "cart_update_url": {{ routes.cart_update_url | append: '.js' | json }},
      "cart_page_url": {{ routes.cart_url | json }}
    }</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
