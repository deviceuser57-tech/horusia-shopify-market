{% if section.blocks.size > 0 %}
  <section class="brand-values-section page-width">
    <header class="section-heading">
      <h2>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'general.home.highlights' | t }}{% endif %}</h2>
      {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
    </header>
    <div class="brand-values-grid">
      {% for block in section.blocks %}
        <article class="brand-value-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180', alt: '' }}{% endif %}
          {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name":"Brand highlights",
  "tag":"section",
  "class":"section-brand-values",
  "settings":[
    {"type":"text","id":"heading","label":"Heading"},
    {"type":"richtext","id":"intro","label":"Introduction"}
  ],
  "blocks":[
    {"type":"value","name":"Highlight","settings":[
      {"type":"image_picker","id":"icon","label":"Image or icon"},
      {"type":"text","id":"title","label":"Title"},
      {"type":"richtext","id":"text","label":"Description"}
    ]}
  ],
  "max_blocks":6,
  "presets":[{"name":"Brand highlights"}]
}
{% endschema %}
