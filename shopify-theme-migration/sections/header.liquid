<header class="site-header" style="--header-bg: {{ section.settings.background }};">
  <div class="header-inner page-width">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '200, 300, 400', class: 'brand-logo', loading: 'eager' }}
      {% else %}
        <span class="brand-name">{{ shop.name }}</span>
      {% endif %}
    </a>
    <nav class="desktop-nav" aria-label="{{ 'general.navigation.main' | t }}">
      {% if section.settings.menu != blank %}
        <ul class="desktop-nav-list">
          {% for link in section.settings.menu.links %}
            <li class="{% if link.links != blank %}has-submenu{% endif %}">
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
              {% if link.links != blank %}
                <ul class="sub-menu">
                  {% for child in link.links %}
                    <li><a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
    <div class="header-actions">
      <button class="icon-button mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="MobileMenu" aria-label="{{ 'general.navigation.menu' | t }}">
        <span></span><span></span><span></span>
      </button>
      <a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        {% render 'icon-search' %}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-button account-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'general.account.account' | t }}">
          {% render 'icon-account' %}
        </a>
      {%- endif -%}
      <a class="cart-link" href="{{ routes.cart_url }}" data-cart-toggle aria-label="{{ 'general.cart.view_cart' | t }}">
        {% render 'icon-cart' %}
        <span data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <nav id="MobileMenu" class="mobile-nav" hidden aria-label="{{ 'general.navigation.mobile' | t }}">
    {% if section.settings.menu != blank %}
      <ul class="mobile-nav-list">
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
            {% if link.links != blank %}
              <button type="button" class="submenu-toggle" aria-expanded="false" aria-label="{{ 'general.navigation.toggle_submenu' | t }} {{ link.title }}">
                <span aria-hidden="true">+</span>
              </button>
              <ul class="sub-menu" hidden>
                {% for child in link.links %}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </nav>
</header>
{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo"},
    {"type":"link_list","id":"menu","label":"Main menu","default":"main-menu"},
    {"type":"color","id":"background","label":"Header background","default":"#f4f6f8"}
  ]
}
{% endschema %}
