{% assign has_benefit_content = false %}
{% for block in section.blocks %}
  {% if block.settings.title != blank or block.settings.text != blank %}
    {% assign has_benefit_content = true %}
  {% endif %}
{% endfor %}
{% if has_benefit_content %}
  <section class="product-content-section page-width">
    <h2>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'general.product.highlights' | t }}{% endif %}</h2>
    <div class="product-benefits-grid">
      {% for block in section.blocks %}
        {% if block.settings.title != blank or block.settings.text != blank %}
          <article class="product-benefit-card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', alt: block.settings.title }}{% endif %}
            {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
            {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name":"Product highlights",
  "tag":"section",
  "class":"section-product-benefits",
  "settings":[{"type":"text","id":"heading","label":"Heading"}],
  "blocks":[
    {"type":"benefit","name":"Highlight","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"title","label":"Title"},
      {"type":"richtext","id":"text","label":"Description"}
    ]}
  ],
  "max_blocks":8,
  "presets":[{"name":"Product highlights"}],
  "enabled_on":{"templates":["product"]}
}
{% endschema %}
