<section class="search-page page-width">
  <h1>{{ 'general.search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="Search">{{ 'general.search.search' | t }}</label>
    <input id="Search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit">{{ 'general.search.submit' | t }}</button>
  </form>
  {% if search.performed %}
    {% paginate search.results by 24 %}
      <p role="status">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% endif %}
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}{% render 'pagination', paginate: paginate %}{% endif %}
    {% endpaginate %}
  {% endif %}
</section>
{% schema %}
{"name":"Search","tag":"section","class":"section-search","settings":[],"presets":[{"name":"Search"}]}
{% endschema %}
