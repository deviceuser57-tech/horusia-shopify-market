<section class="collection-page page-width">
  <header class="collection-header">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
  </header>
  <div class="product-grid">
    {% paginate collection.products by 24 %}
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>{{ 'general.collection.no_products' | t }}</p>
      {% endfor %}
      {% if paginate.pages > 1 %}{% render 'pagination', paginate: paginate %}{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{"name":"Main collection","tag":"section","class":"section-main-collection","settings":[],"presets":[{"name":"Main collection"}]}
{% endschema %}
