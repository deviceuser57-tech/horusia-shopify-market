<section class="hero-carousel page-width" data-carousel data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval }}">
  <div class="hero-slides" aria-live="polite">
    {%- for block in section.blocks -%}
      <article class="hero-slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} data-slide>
        <div class="hero-content hero-content--{{ block.settings.text_align }}" style="text-align: {{ block.settings.text_align }};">
          {% if block.settings.badge != blank %}<p class="hero-badge">{{ block.settings.badge }}</p>{% endif %}
          <h1>{% if block.settings.heading != blank %}{{ block.settings.heading }}{% else %}{{ shop.name }}{% endif %}</h1>
          {% if block.settings.text != blank %}<div class="hero-text">{{ block.settings.text }}</div>{% endif %}
          {% if block.settings.button_link != blank %}
            <a class="button" href="{{ block.settings.button_link }}">{% if block.settings.button_label != blank %}{{ block.settings.button_label }}{% else %}{{ 'general.home.shop' | t }}{% endif %}</a>
          {% endif %}
        </div>
        <div class="hero-media">
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: autoplay: false, loop: false, muted: true, controls: true, image_size: '1600x' }}
          {% elsif block.settings.desktop_image != blank %}
            <picture>
              {% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">{% endif %}
              {{ block.settings.desktop_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '400,800,1200,1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: block.settings.heading }}
            </picture>
          {% else %}
            <img src="{{ 'hero-banner.jpg' | asset_url }}" alt="{{ block.settings.heading | escape }}" loading="eager">
          {% endif %}
        </div>
        <div class="hero-overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
      </article>
    {%- endfor -%}
  </div>
  {% if section.blocks.size > 1 %}
    <div class="carousel-controls">
      <button type="button" data-carousel-prev aria-label="{{ 'general.carousel.previous' | t }}">&larr;</button>
      <button type="button" data-carousel-pause aria-pressed="false">{{ 'general.carousel.pause' | t }}</button>
      <button type="button" data-carousel-next aria-label="{{ 'general.carousel.next' | t }}">&rarr;</button>
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name":"Hero carousel",
  "tag":"section",
  "class":"section-hero",
  "settings":[
    {"type":"checkbox","id":"autoplay","label":"Autoplay","default":false},
    {"type":"range","id":"interval","min":3,"max":12,"step":1,"unit":"s","label":"Autoplay interval","default":6}
  ],
  "blocks":[
    {"type":"slide","name":"Slide","settings":[
      {"type":"text","id":"badge","label":"Badge"},
      {"type":"text","id":"heading","label":"Heading"},
      {"type":"richtext","id":"text","label":"Text"},
      {"type":"text","id":"button_label","label":"Button label"},
      {"type":"url","id":"button_link","label":"Button link"},
      {"type":"image_picker","id":"desktop_image","label":"Desktop image"},
      {"type":"image_picker","id":"mobile_image","label":"Mobile image"},
      {"type":"video","id":"video","label":"Video"},
      {"type":"range","id":"overlay_opacity","min":0,"max":90,"step":5,"unit":"%","label":"Overlay opacity","default":25},
      {"type":"select","id":"text_align","label":"Text alignment","default":"start","options":[{"value":"start","label":"Start"},{"value":"center","label":"Center"},{"value":"end","label":"End"}]}
    ]}
  ],
  "presets":[{"name":"Hero carousel","blocks":[{"type":"slide"}]}],
  "enabled_on":{"templates":["index"]}
}
{% endschema %}
