<section class="product-page page-width" data-product-section data-zoom-enabled="{{ section.settings.enable_zoom }}">
  <div class="product-media">
    {% if product.featured_media %}
      <div class="product-main-image" data-product-main-image-wrapper>
        <img id="MainProductImage" src="{{ product.featured_media.preview_image | image_url: width: 1200 }}"
             srcset="{{ product.featured_media.preview_image | image_url: width: 400 }} 400w, {{ product.featured_media.preview_image | image_url: width: 800 }} 800w, {{ product.featured_media.preview_image | image_url: width: 1200 }} 1200w"
             sizes="(min-width: 990px) 50vw, 100vw" width="1200" height="1200"
             loading="eager" alt="{{ product.featured_media.alt | default: product.title | escape }}" data-product-main-image>
      </div>
    {% endif %}
    {% if product.media.size > 1 %}
      <div class="product-thumbnails" role="group" aria-label="{{ 'general.product.view_image' | t }}">
        {% for media in product.media %}
          {% if media.preview_image %}
            <button type="button" data-product-media="{{ media.id }}" aria-pressed="false" aria-label="{{ 'general.product.view_image' | t }} {{ forloop.index }}"
              data-media-src="{{ media.preview_image | image_url: width: 1200 }}"
              data-media-srcset="{{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 800 }} 800w, {{ media.preview_image | image_url: width: 400 }} 400w"
              data-media-alt="{{ media.alt | default: product.title | escape }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <div class="product-details">
    <h1>{{ product.title }}</h1>
    <div class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>
    <div class="compare-price" data-compare-price {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}hidden{% endunless %}>
      {{ product.selected_or_first_available_variant.compare_at_price | money }}
    </div>
    <div class="rte product-description">{{ product.description }}</div>
    {%- assign selected_variant = product.selected_or_first_available_variant -%}
    {%- assign all_variants_sold_out = true -%}
    {%- for variant in product.variants -%}
      {%- if variant.available -%}
        {%- assign all_variants_sold_out = false -%}
      {%- endif -%}
    {%- endfor -%}
    {% form 'product', product, id: 'ProductForm', class: 'product-form', novalidate: 'novalidate' %}
      {% if product.has_only_default_variant == false %}
        <div class="variant-js-controls">
          {% for option in product.options_with_values %}
            <fieldset class="variant-field">
              <legend>{{ option.name }}</legend>
              <div class="option-values">
                {% assign option_index = forloop.index0 %}
                {% assign selected_option_value = selected_variant.options[option_index] %}
                {% for value in option.values %}
                  <label>
                    <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if value == selected_option_value %}checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
      {% endif %}
      <input type="hidden" data-variant-id value="{{ selected_variant.id }}"{% if all_variants_sold_out %} disabled{% endif %}>
      <noscript>
        <div class="variant-native-selector">
          <label for="VariantSelect-{{ section.id }}">{{ 'general.product.variant' | t }}</label>
          <select id="VariantSelect-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == selected_variant.id %}selected{% endif %}>
                {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} ({{ 'general.product.sold_out' | t }}){% endunless %}
              </option>
            {% endfor %}
          </select>
        </div>
      </noscript>
      <label for="Quantity-{{ section.id }}">{{ 'general.product.quantity' | t }}</label>
      <input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" step="1" value="1" required>
      <button type="submit" class="button product-submit" {% if all_variants_sold_out %}disabled{% endif %}>
        {% if product.available %}{{ 'general.product.add_to_cart' | t }}{% else %}{{ 'general.product.sold_out' | t }}{% endif %}
      </button>
      <p class="form-status" role="status" data-form-status></p>
    {% endform %}
    {% if product.metafields.reviews.rating %}
      {% comment %}Reserved for Shopify app block; no review implementation is embedded.{% endcomment %}
    {% endif %}
    {% for block in section.blocks %}
      {% if block.type == '@app' %}{% render block %}{% endif %}
    {% endfor %}
  </div>
  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>
{% schema %}
{
  "name":"Main product",
  "tag":"section",
  "class":"section-main-product",
  "settings":[
    {"type":"checkbox","id":"enable_zoom","label":"Enable image zoom","default":false}
  ],
  "blocks":[{"type":"@app"}],
  "presets":[{"name":"Main product"}]
}
{% endschema %}
