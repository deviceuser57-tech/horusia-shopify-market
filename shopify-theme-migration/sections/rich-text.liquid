<section class="rich-text page-width">
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
  {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
  {% if section.settings.button_label != blank and section.settings.button_link != blank %}
    <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  {% endif %}
</section>
{% schema %}
{
 "name":"Rich text","tag":"section","class":"section-rich-text",
 "settings":[
  {"type":"text","id":"heading","label":"Heading"},
  {"type":"richtext","id":"text","label":"Text"},
  {"type":"text","id":"button_label","label":"Button label"},
  {"type":"url","id":"button_link","label":"Button link"}
 ],
 "presets":[{"name":"Rich text"}]
}
{% endschema %}
