<article class="product-card">
  <a href="{{ product.url }}" class="product-card-media">
    {% if product.featured_media %}
      {{ product.featured_media.preview_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.featured_media.alt | default: product.title }}
    {% endif %}
  </a>
  <div class="product-card-info">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
  </div>
</article>
